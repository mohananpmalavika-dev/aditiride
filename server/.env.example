# ==============================================================================
# AditiRide Mobility & Logistics Platform Environment Configuration
# ==============================================================================

# Server Environment
PORT=5099
NODE_ENV=development # 'production' enforces PostgreSQL + PostGIS, Redis & strict secrets

# Database Configuration
# Production requires PostgreSQL + PostGIS (SQLite is rejected when NODE_ENV=production)
DATABASE_URL=postgresql://aditi_user:aditi_secure_password@localhost:5432/aditiride
DB_SSL=false

# Distributed Cache & Coordination (ioredis)
# Required in production for distributed driver offer leases, leader lock, and Socket.IO cluster
REDIS_URL=redis://localhost:6379

# Cryptographic Authentication & Persistent Sessions
JWT_SECRET=replace_with_cryptographically_secure_256bit_access_secret_2026
JWT_REFRESH_SECRET=replace_with_cryptographically_secure_256bit_refresh_secret_2026

# Payment Gateway Configuration
# Supported providers: 'MOCK' (local dev) | 'RAZORPAY' (production) | 'CASHFREE'
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# Security & CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5180,http://localhost:3000,http://127.0.0.1:5180

# Telecom & Emergency Safety Dispatcher
EMERGENCY_HELPLINE=112
POLICE_CONTROL_ROOM=+914872424100
